{
  "name": "maskobalo",
  "version": "0.1.0",
  "description": "codename: Maskobalo",
  "keywords": [],
  "homepage": "https://github.com/kurone-kito/maskobalo#readme",
  "bugs": "https://github.com/kurone-kito/maskobalo/issues",
  "license": "MIT",
  "author": "kurone-kito <krone@kit.black> (https://kit.black/)",
  "type": "module",
  "private": true,
  "files": [],
  "repository": "github:kurone-kito/maskobalo",
  "scripts": {
    "build": "yarn run sub --topological-dev -t run build",
    "build:re": "yarn run clean && yarn run build",
    "clean": "concurrently \"yarn:clean:*\"",
    "clean:root": "rimraf \".eslintcache\" \"*.tgz\" \"*.tsbuildinfo\"",
    "clean:sub": "yarn run sub run clean",
    "lint": "eslint --cache --format codeframe \"$@\" \"./**/*\"",
    "lint:fix": "yarn run lint --fix",
    "pack": "yarn run sub --topological-dev -t pack",
    "postinstall": "husky install",
    "prepack": "yarn run pack",
    "start": "yarn workspace @maskobalo/common run build && yarn run sub -j 3 run start",
    "sub": "yarn workspaces foreach --exclude \"maskobalo\" -ipv \"$@\""
  },
  "devDependencies": {
    "@commitlint/cli": "^15.0.0",
    "@commitlint/config-conventional": "^15.0.0",
    "@types/eslint": "^8.2.1",
    "@typescript-eslint/eslint-plugin": "^5.6.0",
    "@typescript-eslint/parser": "^5.6.0",
    "concurrently": "^6.4.0",
    "eslint": "^8.4.1",
    "eslint-config-airbnb-typescript": "^16.1.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-formatter-codeframe": "^7.32.1",
    "eslint-import-resolver-node": "^0.3.6",
    "eslint-import-resolver-typescript": "^2.5.0",
    "eslint-plugin-editorconfig": "^3.2.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsdoc": "^37.2.0",
    "eslint-plugin-json": "^3.1.0",
    "eslint-plugin-lodash": "^7.3.0",
    "eslint-plugin-markdown": "^2.2.1",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-yaml": "^0.5.0",
    "husky": "^7.0.4",
    "prettier": "^2.5.1",
    "pretty-quick": "^3.1.2",
    "rimraf": "^3.0.2",
    "typescript": "~4.4.4",
    "typescript-eslint-language-service": "^5.0.0"
  },
  "engines": {
    "node": "^17.2.0",
    "yarn": "^2.4.3"
  },
  "packageManager": "yarn@3.1.1",
  "workspaces": {
    "packages": [
      "./packages/*"
    ]
  }
}
