{
  "name": "maskobalo",
  "version": "0.1.0",
  "private": true,
  "description": "Voice chat application specialized for TRPG and voice parties.",
  "keywords": [
    "voice-chat",
    "trpg",
    "voice-party",
    "webrtc",
    "solid",
    "cloudflare-workers"
  ],
  "homepage": "https://github.com/kurone-kito/maskobalo#readme",
  "bugs": "https://github.com/kurone-kito/maskobalo/issues",
  "repository": "github:kurone-kito/maskobalo",
  "license": "MIT",
  "author": "kurone-kito <krone@kit.black> (https://kit.black/)",
  "type": "module",
  "scripts": {
    "build": "pnpm --aggregate-output --if-present --workspace-concurrency=0 -r run build",
    "clean": "pnpm run --no-bail \"/^clean:.+/\"",
    "clean:root": "rimraf -g \"*.tgz\" \"*.tsbuildinfo\" coverage node_modules/.cache",
    "clean:sub": "pnpm --aggregate-output --if-present --parallel --workspace-concurrency=0 -r run clean",
    "dev": "pnpm --if-present --parallel --stream --workspace-concurrency=Infinity -r run dev",
    "lint": "pnpm run --stream \"/lint:check:.+/\"",
    "lint:check:biome": "biome check",
    "lint:check:cspell": "cspell lint --no-progress --show-suggestions .",
    "lint:check:markdown": "markdownlint-cli2 \"**/*.md\"",
    "lint:check:okf": "node scripts/okf-validate.mjs",
    "lint:fix": "pnpm run --stream \"/(lint:fix:.+|lint:check:cspell)/\"",
    "lint:fix:biome": "biome check --write",
    "lint:fix:markdown": "markdownlint-cli2 --fix \"**/*.md\"",
    "prepare": "husky",
    "test": "pnpm run --stream \"/test:.+/\"",
    "test:vitest": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --aggregate-output --if-present --workspace-concurrency=0 -r run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@cspell/cspell-types": "^10.3.5",
    "@kurone-kito/biome-config": "^0.23.0",
    "@kurone-kito/commitlint-config": "^0.23.0-alpha.1",
    "@kurone-kito/cspell-config": "^0.23.0",
    "@kurone-kito/lint-staged-config": "^0.23.0-alpha.1",
    "@kurone-kito/markdownlint-config": "^0.23.0-alpha.1",
    "@kurone-kito/typescript-config": "^0.22.0-alpha.9",
    "@vitest/coverage-v8": "^5.0.2",
    "cspell": "^10.3.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800",
  "engines": {
    "node": ">=24"
  }
}
