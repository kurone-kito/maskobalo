# `git-checks=false` lets `pnpm publish` proceed from a dirty worktree.
# We keep this on because maskobalo is a private app (not a published
# library); the repository's branch protection plus the `lint +
# typecheck + test` CI pipeline enforce cleanliness instead of pnpm.
# Add a release workflow alongside this comment if maskobalo ever
# starts producing published artifacts.
git-checks=false
ignore-workspace-root-check=true
link-workspace-packages=true
