{
  "name": "@maskobalo/common",
  "version": "0.1.0",
  "description": "Maskobalo common package",
  "keywords": [],
  "homepage": "https://github.com/kurone-kito/maskobalo#readme",
  "bugs": "https://github.com/kurone-kito/maskobalo/issues",
  "license": "MIT",
  "author": "kurone-kito <krone@kit.black> (https://kit.black/)",
  "private": true,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/kurone-kito/maskobalo.git",
    "directory": "packages/common"
  },
  "scripts": {
    "build": "concurrently \"yarn:build:*\"",
    "build:es": "node esbuild.config.mjs",
    "build:ts": "tsc",
    "clean": "rimraf \"dist\" \"*.tgz\" \"*.tsbuildinfo\"",
    "prepack": "yarn run clean && yarn run build",
    "start": "concurrently \"yarn:watch:*\"",
    "watch:es": "cross-env WATCH=true yarn run build:es",
    "watch:ts": "tsc --watch"
  },
  "devDependencies": {
    "concurrently": "^6.4.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.14.3",
    "rimraf": "^3.0.2",
    "type-fest": "^2.8.0",
    "typescript": "~4.4.4"
  },
  "engines": {
    "node": "^17.2.0",
    "yarn": "^2.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
